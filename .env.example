# Supabase (optional) — enables cross-session persistence of preferences and
# plan history via anonymous auth. Without these, the app falls back to
# localStorage only and still works fully.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# AI generation (optional) — enables live model-generated plans/recipes.
# Without a key, the app falls back to the built-in mock recipe generator.
VITE_AI_PROVIDER=mock
VITE_OPENAI_API_KEY=
VITE_ANTHROPIC_API_KEY=
